utputs":[{"name":"stdout","output_type":"stream","text":["\n","Solution for 8-queen problem:\n","\n","Q . . . . . . .\n",". . . . Q . . .\n",". . . . . . . Q\n",". . . . . Q . .\n",". . Q . . . . .\n",". . . . . . Q .\n",". Q . . . . . .\n",". . . Q . . . .\n"]}],"source":["def print_board(board):\n","    for row in board:\n","        print(\" \".join(row))\n","\n","\n","def is_safe(board, row, col):\n","    # Check this column on upper rows\n","    for i in range(row):\n","        if board[i][col] == 'Q':\n","            return False\n","\n","    # Check upper-left diagonal\n","    i = row - 1\n","    j = col - 1\n","    while i >= 0 and j >= 0:\n","        if board[i][j] == 'Q':\n","            return False\n","        i -= 1\n","        j -= 1\n","\n","    # Check upper-right diagonal\n","    i = row - 1\n","    j = col + 1\n","    while i >= 0 and j < 8:\n","        if board[i][j] == 'Q':\n","            return False\n","        i -= 1\n","        j += 1\n","\n","    return True\n","\n","\n","def solve(board, row):\n","    if row == 8:\n","        return True\n","\n","    for col in range(8):\n","        if is_safe(board, row, col):\n","            board[row][col] = 'Q'\n","\n","            if solve(board, row + 1):\n","                return True\n","\n","            board[row][col] = '.' # Backtrack\n","    return False\n","\n","\n","# Main execution part\n","board = [['.' for _ in range(8)] for _ in range(8)]\n","\n","if solve(board, 0):\n","    print(\"\\nSolution for 8-queen problem:\\n\")\n","    print_board(board)\n","else:\n","    print(\"No solution exists\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"Cqr2WM8VQxI0"},"outputs":[],"source":["from collections import deque\n","\n","# function to solve water jug problem using BFS\n","def water_jug(capacity1, capacity2, target):\n","  visited = set()  # Use a set for efficient lookup\n","  queue = deque()\n","\n","  # initial state: both jugs are empty, with an empty path\n","  queue.append((0, 0, []))\n","  visited.add((0, 0))\n","\n","  while queue:\n","    jug1, jug2, path = queue.popleft()\n","\n","    # Check if the target is reached\n","    if jug1 == target or jug2 == target:\n","      return path + [(jug1, jug2)]\n","\n","    # Generate all possible next states\n","    next_states = []\n","\n","    # 1. Fill jug1\n","    next_states.append((capacity1, jug2, path + [(capacity1, jug2)]))\n","    # 2. Fill jug2\n","    next_states.append((jug1, capacity2, path + [(jug1, capacity2)]))\n","    # 3. Empty jug1\n","    next_states.append((0, jug2, path + [(0, jug2)]))\n","    # 4. Empty jug2\n","    next_states.append((jug1, 0, path + [(jug1, 0)]))\n","    # 5. Pour jug1 to jug2\n","    pour_to_jug2 = min(jug1, capacity2 - jug2)\n","    next_states.append((jug1 - pour_to_jug2, jug2 + pour_to_jug2, path + [(jug1 - pour_to_jug2, jug2 + pour_to_jug2)]))\n","    # 6. Pour jug2 to jug1\n","    pour_to_jug1 = min(jug2, capacity1 - jug1)\n","    next_states.append((jug1 + pour_to_jug1, jug2 - pour_to_jug1, path + [(jug1 + pour_to_jug1, jug2 - pour_to_jug1)]))\n","\n","    # Enqueue valid next states\n","    for next_jug1, next_jug2, next_path in next_states:\n","      if (next_jug1, next_jug2) not in visited:\n","        visited.add((next_jug1, next_jug2))\n","        queue.append((next_jug1, next_jug2, next_path))\n","\n","  return None # No solution found"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":27190,"status":"ok","timestamp":1790134996271,"user":{"displayName":"25CSEAIML285 ENGA CHIDANANDA","userId":"15955946011188748723"},"user_tz":-330},"id":"2db46826","outputId":"33d7e54e-31af-426c-a2a7-b220a3f5cc36"},"outputs":[{"name":"stdout","output_type":"stream","text":["Enter capacity for jug 1: 3\n","Enter capacity for jug 2: 4\n","Enter target amount: 2\n","\n","Solution for Water Jug Problem (capacities: 3, 4, target: 2):\n","Step 0: Jug1=3, Jug2=0\n","Step 1: Jug1=